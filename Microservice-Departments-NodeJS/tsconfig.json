{
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"],
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "./src", "outDir": "./dist", "module": "nodenext", "target": "esnext",
    "types": ["node", "jest"], "esModuleInterop": true, "sourceMap": true, "declaration": true, "declarationMap": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "strict": true,
    "isolatedModules": true, "noUncheckedSideEffectImports": true, "moduleDetection": "force", "skipLibCheck": true
  }
}
